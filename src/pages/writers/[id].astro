---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
export async function getStaticPaths() {
  const all = (await getCollection('essays')).sort((a, b) => a.data.order - b.data.order);
  return all.map((e, i) => ({ params: { id: e.id }, props: { e, prev: all[i - 1], next: all[i + 1] } }));
}
interface Props { e: CollectionEntry<'essays'>; prev?: CollectionEntry<'essays'>; next?: CollectionEntry<'essays'> }
const { e, prev, next } = Astro.props;
// Rendered with marked (no smart-quote substitution) so the text stays exactly as written.
const html = await marked.parse(e.body ?? '');
---
<Base title={e.data.title}>
  <p class="text-sm"><a href="/writers" class="text-accent">&larr; Science Fiction Writers I Like</a></p>
  <article>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mt-3">{e.data.title}</h1>
    <div class="prose prose-lg max-w-none mt-8 prose-a:text-accent"><Fragment set:html={html} /></div>
  </article>
  <nav class="mt-10 pt-6 border-t border-black/10 grid grid-cols-2 gap-4 text-sm">
    <div>{prev && <a href={`/writers/${prev.id}`} class="group block"><span class="text-black/50">&larr; Previous</span><span class="block mt-1 font-medium group-hover:text-accent">{prev.data.title}</span></a>}</div>
    <div class="text-right">{next && <a href={`/writers/${next.id}`} class="group block"><span class="text-black/50">Next &rarr;</span><span class="block mt-1 font-medium group-hover:text-accent">{next.data.title}</span></a>}</div>
  </nav>
</Base>
